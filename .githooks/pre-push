#!/usr/bin/env sh
# Refuse to publish a commit whose author or committer address is not the
# configured user.email.
#
# pre-commit already rejects an override at commit time, but only for commits
# it saw: a --no-verify, a tool that bypasses hooks, a rebase that replays old
# commits, or history written before the hooks existed all reach the push
# unchecked. Publication is the point of no return for an address, so the
# finished commits are inspected here, committer field included.
#
# Deliberate override: push with --no-verify.
set -eu

# The configured identity is read from config FILES only: a `git -c
# user.email=...` override would otherwise move both sides of the comparison
# and pass. --show-origin prints "<origin>\t<value>" per source in increasing
# precedence, so the last file: line is the effective file value.
configured=$(git config --show-origin --get-all user.email 2>/dev/null |
	awk -F'\t' '$1 ~ /^file:/ { v = $2 } END { print v }')
[ -n "$configured" ] || exit 0

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # branch deletion
	# A commit that a remote-tracking ref already holds is published, so it is
	# not examined again. A squash merge on GitHub is one example: its committer
	# is noreply@github.com, and it reaches origin and the next pull request
	# branch from github/main. Fetch first, so the remote-tracking refs are
	# current.
	if [ "$remote_sha" = "$zero" ]; then
		range="$local_sha --not --remotes"
	else
		range="$remote_sha..$local_sha --not --remotes"
	fi
	# shellcheck disable=SC2086 # range is two or three deliberate arguments.
	bad=$(git log --format='%h %ae %ce' $range | awk -v want="$configured" '$2 != want || $3 != want')
	if [ -n "$bad" ]; then
		echo "pre-push: these commits carry an address other than the configured <$configured>:" >&2
		echo "$bad" >&2
		echo "pre-push: rewrite them (git filter-branch --env-filter, or git rebase -x) before publishing, or push with --no-verify." >&2
		status=1
	fi
done

exit "$status"
