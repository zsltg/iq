# Path to the iq config file (saved sources plus the active source and group, and
# stored option defaults). Default: <os user config dir>/iq/iq.toml (e.g.
# ~/.config/iq/iq.toml on Linux). The global --config flag overrides this per run.
# The CLI connects only through saved sources — see `iq add`, `iq src`, `iq ls`,
# and `iq config` for stored defaults.
IQ_CONFIG=

# Editor opened by `iq config edit` (falls back to VISUAL, then EDITOR, then vi).
IQ_EDITOR=

# Logging (read by the CLI when the matching --log* flag is not set; precedence
# is flag > env > default). IQ_LOG activates file logging; IQ_LOG_FILE sets the
# destination (empty disables; default <os user cache dir>/iq/iq.log). Level is
# DEBUG|INFO|WARN|ERROR, format is text|json.
IQ_LOG=
IQ_LOG_FILE=
IQ_LOG_LEVEL=
IQ_LOG_FORMAT=

# Optional overrides for the integration tests only (read by `go test`, not the
# CLI). Unset, the Redis + MongoDB + Cassandra + DynamoDB Local + CouchDB suites start
# ephemeral containers via testcontainers-go. Set these to point at an already-running
# server instead (for example the docker compose stack). The database in the Mongo path
# and the keyspace in the Cassandra path are the test namespace, created by the tests.
# The DynamoDB path connects to a local endpoint with dummy AWS credentials (DynamoDB
# Local ignores them); the tests create and drop their tables. The CouchDB path is the
# server root (credentials in userinfo); the tests create and drop their databases.
# HBase is the exception: its
# native RPC needs a fixed-hostname cluster (testcontainers' random ports would break
# the region server's advertised name), so its integration tests run only when
# IQ_HBASE_URL points at a running cluster (docker compose up -d --wait); the tests
# create and drop their own tables in the default namespace.
IQ_REDIS_URL=redis://localhost:6379/0
IQ_MONGO_URL=mongodb://localhost:27017/iq_test
IQ_CASSANDRA_URL=cassandra://localhost:9042/iq_test
IQ_DYNAMODB_URL=dynamodb://us-east-1/?endpoint=http://localhost:8000
IQ_HBASE_URL=hbase://localhost:2181/
IQ_COUCHDB_URL=couchdb://admin:password@localhost:5984/
