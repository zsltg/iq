# Database connection URL used by the CLI. The scheme selects the backend:
# redis://[user:pass@]host:port[/db] or mongodb://host:port/db. Overridden by the
# --url/-u flag. IQ_REDIS_URL is still honored for back-compat if IQ_URL is unset.
IQ_URL=redis://localhost:6379/0
IQ_REDIS_URL=redis://localhost:6379/0

# MongoDB URL for the integration tests (used only by `go test`, not the CLI).
# The database in the path is the test database.
IQ_MONGO_URL=mongodb://localhost:27017/iq_test
