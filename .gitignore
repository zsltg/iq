# Compiled binary.
/iq
/dist/

# Test and coverage output (coverage.* anchored to root so scripts/coverage.sh is tracked).
*.out
/coverage.*

# Release: the goreleaser CycloneDX module SBOM (regenerated per release).
/iq.cdx.json

# Release: the license texts of the linked modules (regenerated per release).
/third-party-licenses/

# Mutation gate (mutago) run output; the baseline is tracked, these are not.
/report.json
/mutago-report.html
/mutago-summary.json
/mutago-agentic.json
/mutago-baseline.candidate.json
/mutago-gitlab.json

# Docs site (Zensical): local venv, build output, and build cache; sources and uv.lock are tracked.
/docs/.venv/
/docs/site/
/docs/.cache/

# Docs: the concatenated manual, written by scripts/docs.sh on every build.
/docs/docs/llms-full.txt

# Local env (the tracked template is .env.example).
.env

# OS and editor cruft.
.DS_Store
*~
