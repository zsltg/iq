You will need to start a new shell for this setup to take effect. 
.PP
\fBFlags:\fR
.TP
\fB\-\-no\-descriptions\fR
disable completion descriptions
.SH EXAMPLES
.RS
.nf
  # Register a Redis source (active) and a Mongo source whose password is kept safe.
  # The Mongo URI sets a default collection with ?collection=orders.
  $ iq add \-a \-n cache redis://localhost:6379/0
  $ iq add \-p \-\-store keyring 'mongodb://user@localhost:27017/shop?collection=orders'

  # List saved sources (the active one marked *); check reachability; inspect metadata.
  $ iq ls
  $ iq ping
  $ iq inspect shop.orders

  # Fetch one key from the active Redis source.
  $ iq '.greeting'

  # Query a Mongo collection; select(...) pushes to the backend.
  $ iq '.[] | select(.total > 99) | .id' \-\-src shop.orders

  # The URI's ?collection= default lets you drop the suffix.
  $ iq '.[]' \-\-src shop

  # Output as JSON Lines, or one JSON array written to a file.
  $ iq '.[]' \-\-src shop.orders \-\-jsonl
  $ iq '.[]' \-\-src shop.orders \-A \-o results.json

  # Join two sources in one filter with source() (runs over null input, needs no active source).
  $ iq 'INDEX(source("users"; ".[]"); .id) as $u
      | source("orders"; ".[] | select(.total > 99)") | {name: $u[.userId].name, total}'

  # Join two collections of one source on a shared id (each spec binds $shop_orders, $shop_users).
  $ iq combine 'shop.orders=.[] | {id, total}' 'shop.users=.[] | {id, name}' \e
      \-\-with '($shop_users | INDEX(.id)) as $u | $shop_orders[] | . + {name: $u[.id].name}'

  # Query a piped dump file (implicit stdin).
  $ cat dump.jsonl | iq '.[]'
.fi
.RE
