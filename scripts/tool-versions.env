# Versions of the developer and CI tools. Each tool runs through `go run <package>@<version>`
# (or `uvx` for zizmor), so no tool enters go.mod. This file is the only place for these
# pins. Make reads it with `include`, and bash and the workflows read it with `. file`.
# Keep plain KEY=value lines: no spaces around `=`, no quotes. Renovate reads the
# `# renovate:` line above each pin. A new pin needs that line directly above it.
# MUTAGO_VERSION and CAPSLOCK_VERSION stay in scripts/mutation-gate.sh and
# scripts/capabilities.sh, because other scripts read them there.

# Version 2.12 and older bundle a staticcheck that panics on Go 1.27.
# renovate: datasource=go depName=github.com/golangci/golangci-lint/v2
GOLANGCI_LINT_VERSION=v2.15.0

# renovate: datasource=go depName=golang.org/x/vuln
GOVULNCHECK_VERSION=v1.9.0

# renovate: datasource=go depName=github.com/betterleaks/betterleaks
BETTERLEAKS_VERSION=v1.9.0

# renovate: datasource=go depName=github.com/google/osv-scanner/v2
OSV_SCANNER_VERSION=v2.7.0

# renovate: datasource=go depName=golang.org/x/tools
DEADCODE_VERSION=v0.52.0

# renovate: datasource=go depName=github.com/anchore/syft
SYFT_VERSION=v1.54.1

# PyPI package, so the version has no v prefix.
# renovate: datasource=pypi depName=zizmor
ZIZMOR_VERSION=1.31.1

# renovate: datasource=go depName=github.com/rhysd/actionlint
ACTIONLINT_VERSION=v1.7.12

# renovate: datasource=go depName=github.com/goreleaser/goreleaser/v2
GORELEASER_VERSION=v2.18.3

# renovate: datasource=go depName=github.com/caarlos0/svu
SVU_VERSION=v3.4.1

# renovate: datasource=go depName=github.com/git-chglog/git-chglog
GIT_CHGLOG_VERSION=v0.15.4
